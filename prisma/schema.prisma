// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Coach {
  id           String         @id @default(cuid())
  clerkUserId  String         @unique
  name         String
  username     String         @unique
  bio          String?
  avatarUrl    String?
  timezone     String         @default("UTC")
  sessionTypes SessionType[]
  availability Availability[]
  overrides    DateOverride[]
  bookings     Booking[]
  createdAt    DateTime       @default(now())
}

model SessionType {
  id          String    @id @default(cuid())
  coachId     String
  coach       Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  duration    Int // minutes
  price       Int? // cents; null = free session
  color       String    @default("#6366f1")
  isActive    Boolean   @default(true)
  bookings    Booking[]

  @@unique([coachId, slug])
}

model Availability {
  id        String @id @default(cuid())
  coachId   String
  coach     Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "09:00"
  endTime   String // "17:00"

  @@index([coachId, dayOfWeek])
}

model DateOverride {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  date      DateTime
  isBlocked Boolean  @default(true) // true = day off, false = special hours
  startTime String?
  endTime   String?

  @@index([coachId, date])
}

model Booking {
  id            String        @id @default(cuid())
  sessionTypeId String
  sessionType   SessionType   @relation(fields: [sessionTypeId], references: [id], onDelete: Restrict)
  coachId       String
  coach         Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientName    String
  clientEmail   String
  clientNotes   String?
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now())

  @@index([coachId, startTime])
  @@index([sessionTypeId])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}
