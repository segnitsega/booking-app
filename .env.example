# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is gitignored.

# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public site URL used in confirmation emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (https://resend.com) — booking confirmation emails
RESEND_API_KEY="re_xxxxxxxx"
# Use onboarding@resend.dev while testing, or your verified domain
RESEND_FROM_EMAIL="BrandElevate <onboarding@resend.dev>"

# Clerk auth (https://clerk.com) — dashboard gate + coach identity
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Optional: public coach profile linked from the landing "Get started" button
NEXT_PUBLIC_FEATURED_COACH_USERNAME="alex"

# Optional: first signed-in user claims this seeded coach (default alex)
# when that coach still has the demo clerkUserId from prisma/seed.ts
DEMO_CLAIM_USERNAME="alex"
