# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is gitignored.

# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public site URL used in confirmation emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (https://resend.com) — booking confirmation emails
RESEND_API_KEY="re_xxxxxxxx"
# Use onboarding@resend.dev while testing, or your verified domain
RESEND_FROM_EMAIL="BrandElevate <onboarding@resend.dev>"

# Temporary dashboard coach until Clerk auth (Step 10)
DEMO_COACH_USERNAME="alex"
